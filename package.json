{
  "name": "ds-font-config",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Typography and sidebar layout settings for DeepSeek Harness: per-surface font family, size, and line height, sidebar-terminal typography, an optional rail-hiding collapsed sidebar, an expandable draft, and an OpenCode Go usage readout in the sidebar foot.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamyay/ds-font-config.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
