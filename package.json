{
  "name": "ds-font-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typography settings for DeepSeek Harness: independent font family, size, and line height for the interface, conversation, artifact preview, and monospace text.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamyay/ds-font-config.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
